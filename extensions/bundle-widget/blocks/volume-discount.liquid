{% comment %}
  Nitos Volume Discount Widget — Theme App Extension Block
  Merchants add this block from Online Store → Themes → Customize → Add section → Apps → Volume Discount
  Self-contained inline CSS + vanilla JS. No external dependencies.
{% endcomment %}

{% assign brand_id = block.settings.brand_id %}
{% assign product_id = block.settings.product_id %}
{% assign accent_color = block.settings.accent_color | default: "#6366f1" %}
{% assign api_url = block.settings.api_url | default: "https://nitaiecompro-nine.vercel.app" %}

<div
  id="nitos-vd-root"
  data-brand="{{ brand_id | escape }}"
  data-product="{{ product_id | escape }}"
  data-color="{{ accent_color | escape }}"
  data-api="{{ api_url | escape }}"
  {{ block.shopify_attributes }}
></div>

<style>
  #nitos-vd-root {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    font-size: 14px;
    max-width: 480px;
  }

  .nvd-title {
    font-size: 15px;
    font-weight: 700;
    color: #1a1a2e;
    margin: 0 0 12px;
  }

  .nvd-tiers {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .nvd-tier {
    position: relative;
    border: 2px solid #e5e7eb;
    border-radius: 12px;
    padding: 14px 16px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 14px;
    transition: border-color 0.18s, box-shadow 0.18s, background 0.18s;
    background: #fff;
    user-select: none;
  }

  .nvd-tier:hover {
    border-color: #d1d5db;
    background: #fafafa;
  }

  .nvd-tier.nvd-selected {
    border-color: {{ accent_color }};
    background: {{ accent_color }}0a;
    box-shadow: 0 0 0 1px {{ accent_color }}33;
  }

  .nvd-radio {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    border: 2px solid #d1d5db;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: border-color 0.18s;
  }

  .nvd-selected .nvd-radio {
    border-color: {{ accent_color }};
  }

  .nvd-radio-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: {{ accent_color }};
    transform: scale(0);
    transition: transform 0.18s;
  }

  .nvd-selected .nvd-radio-dot {
    transform: scale(1);
  }

  .nvd-info {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    flex-wrap: wrap;
  }

  .nvd-label {
    font-weight: 600;
    color: #1a1a2e;
    font-size: 14px;
  }

  .nvd-discount {
    font-size: 12px;
    font-weight: 600;
    color: {{ accent_color }};
    background: {{ accent_color }}14;
    padding: 2px 8px;
    border-radius: 20px;
  }

  .nvd-pricing {
    text-align: right;
  }

  .nvd-per-unit {
    font-weight: 700;
    color: #1a1a2e;
    font-size: 14px;
  }

  .nvd-total {
    font-size: 12px;
    color: #6b7280;
    margin-top: 1px;
  }

  .nvd-badge {
    position: absolute;
    top: -9px;
    left: 50%;
    transform: translateX(-50%);
    background: {{ accent_color }};
    color: #fff;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 2px 10px;
    border-radius: 20px;
    white-space: nowrap;
  }

  .nvd-loading {
    text-align: center;
    padding: 20px;
    color: #9ca3af;
    font-size: 13px;
  }

  .nvd-error {
    text-align: center;
    padding: 16px;
    color: #ef4444;
    font-size: 13px;
  }
</style>

<script>
(function() {
  var root = document.getElementById('nitos-vd-root');
  var brandId   = root.dataset.brand   || '';
  var productId = root.dataset.product || '';
  var apiBase   = root.dataset.api     || '';

  if (!brandId || !productId) return;

  root.innerHTML = '<div class="nvd-loading">Loading volume discounts&hellip;</div>';

  var url = apiBase + '/api/widgets/bundles?brand=' + encodeURIComponent(brandId)
          + '&product=' + encodeURIComponent(productId) + '&type=volume';

  fetch(url)
    .then(function(res) {
      if (!res.ok) throw new Error('HTTP ' + res.status);
      return res.json();
    })
    .then(function(data) {
      if (!data.tiers || !data.tiers.length) {
        root.innerHTML = '';
        return;
      }
      render(data.tiers);
    })
    .catch(function() {
      root.innerHTML = '<div class="nvd-error">Unable to load volume discounts.</div>';
    });

  function render(tiers) {
    var basePrice = getProductPrice();
    var midIndex = Math.floor(tiers.length / 2);

    var html = '<p class="nvd-title">Buy More, Save More</p><div class="nvd-tiers">';

    tiers.forEach(function(tier, i) {
      var unitPrice = basePrice * (1 - tier.discount_pct / 100);
      var totalPrice = unitPrice * tier.qty;
      var isMid = (tiers.length >= 3 && i === midIndex);

      html += '<div class="nvd-tier" data-qty="' + tier.qty + '" data-index="' + i + '">';
      if (isMid) {
        html += '<span class="nvd-badge">Most Popular</span>';
      }
      html += '<div class="nvd-radio"><div class="nvd-radio-dot"></div></div>';
      html += '<div class="nvd-info">';
      html += '<div>';
      html += '<div class="nvd-label">' + escHtml(tier.label) + '</div>';
      html += '<span class="nvd-discount">Save ' + tier.discount_pct + '%</span>';
      html += '</div>';
      html += '<div class="nvd-pricing">';
      html += '<div class="nvd-per-unit">' + formatMoney(unitPrice) + ' each</div>';
      html += '<div class="nvd-total">Total: ' + formatMoney(totalPrice) + '</div>';
      html += '</div>';
      html += '</div>';
      html += '</div>';
    });

    html += '</div>';
    root.innerHTML = html;

    /* Select first tier by default */
    selectTier(0);

    /* Click handlers */
    var cards = root.querySelectorAll('.nvd-tier');
    cards.forEach(function(card) {
      card.addEventListener('click', function() {
        selectTier(parseInt(this.dataset.index, 10));
      });
    });
  }

  function selectTier(index) {
    var cards = root.querySelectorAll('.nvd-tier');
    cards.forEach(function(c, i) {
      if (i === index) {
        c.classList.add('nvd-selected');
        c.setAttribute('aria-checked', 'true');
        updateQuantity(parseInt(c.dataset.qty, 10));
      } else {
        c.classList.remove('nvd-selected');
        c.setAttribute('aria-checked', 'false');
      }
    });
  }

  function updateQuantity(qty) {
    var qtyInput = document.querySelector('form[action*="/cart/add"] [name="quantity"], form[action*="/cart"] input[name="quantity"]');
    if (qtyInput) {
      qtyInput.value = qty;
      qtyInput.dispatchEvent(new Event('change', { bubbles: true }));
    }
  }

  function getProductPrice() {
    /* Try Shopify's global product JSON first */
    if (window.ShopifyAnalytics && window.ShopifyAnalytics.meta && window.ShopifyAnalytics.meta.product) {
      return window.ShopifyAnalytics.meta.product.variants[0].price / 100;
    }
    /* Fallback: look for meta tag */
    var meta = document.querySelector('meta[property="og:price:amount"]');
    if (meta) return parseFloat(meta.content) || 0;
    return 0;
  }

  function formatMoney(amount) {
    if (window.Shopify && window.Shopify.formatMoney) {
      return window.Shopify.formatMoney(amount * 100);
    }
    return '$' + amount.toFixed(2);
  }

  function escHtml(s) {
    return String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }
})();
</script>

{% schema %}
{
  "name": "Volume Discount",
  "target": "section",
  "javascript": null,
  "stylesheet": null,
  "settings": [
    {
      "type": "text",
      "id": "brand_id",
      "label": "Brand ID",
      "info": "Your Nitos brand ID from the dashboard"
    },
    {
      "type": "text",
      "id": "product_id",
      "label": "Product ID",
      "info": "Shopify product ID for volume discount tiers"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#6366f1"
    },
    {
      "type": "text",
      "id": "api_url",
      "label": "API URL",
      "default": "https://nitaiecompro-nine.vercel.app",
      "info": "Leave as default unless you have a custom domain"
    }
  ]
}
{% endschema %}
