# Supabase (get from Supabase dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# App
NEXT_PUBLIC_APP_URL=https://nitaiecompro-nine.vercel.app

# Shopify (get from Shopify Partner Dashboard → App → API credentials)
SHOPIFY_CLIENT_ID=your-shopify-client-id
SHOPIFY_CLIENT_SECRET=your-shopify-client-secret
SHOPIFY_WEBHOOK_SECRET=your-shopify-webhook-secret   # Partner Dashboard → Notifications → Webhook secret

# AWS SES (get from AWS Console → IAM → Access Keys)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
SES_CONFIGURATION_SET=your-ses-configuration-set-name

# Telegram notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
